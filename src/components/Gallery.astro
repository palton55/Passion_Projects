---
const { photos } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
{photos.length > 0 && (
  <div class="gallery">
    {photos.map((p: { src: string; caption?: string }) => (
      <figure>
        <a href={`${base}/${p.src}`} target="_blank"><img src={`${base}/${p.src}`} alt={p.caption ?? ''} loading="lazy" /></a>
        {p.caption && <figcaption>{p.caption}</figcaption>}
      </figure>
    ))}
  </div>
)}
<style>
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  figure { margin: 0; }
  img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 10px; }
  figcaption { font-size: .85rem; color: var(--muted); margin-top: 4px; }
</style>
