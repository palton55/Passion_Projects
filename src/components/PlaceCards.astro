---
// Cards linking to the encyclopedia-style place pages, each with its first photo and opening sentence.
import type { PlacePage } from '../lib/place-notes';
const { places } = Astro.props as { places: PlacePage[] };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const first = (s: string) => s.match(/^.*?\.(?=\s|$)/)?.[0] ?? s;
---
{places.length > 0 && (
  <div class="cards">
    {places.map((p) => (
      <a class="card" href={`${base}/places/${p.slug}/`}>
        {p.pics[0] && <img src={`${base}/${p.pics[0].src}`} alt={p.pics[0].caption ?? p.name} loading="lazy" />}
        <div class="body">
          <p class="area">{p.area}</p>
          <h3>{p.name}</h3>
          <p>{first(p.text[0])}</p>
        </div>
      </a>
    ))}
  </div>
)}
<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; margin: 20px 0; }
  .card { display: block; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; text-decoration: none; color: var(--text); transition: transform .15s; }
  .card:hover { transform: translateY(-3px); }
  img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; }
  .body { padding: 12px 14px 16px; }
  .area { margin: 0; font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  h3 { margin: 2px 0 6px; font-size: 1.1rem; }
  .body p:last-child { margin: 0; color: var(--muted); font-size: .9rem; }
</style>
