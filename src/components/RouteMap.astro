---
// Road map: stops are the places visited. Optional `legs` draw the real route (e.g. rail lines);
// without legs, stops are joined in order by straight lines.
// Optional `groups` (e.g. years) add toggle buttons; legs and stops then carry `groups: string[]`.
// Drive legs are photo-GPS waypoints, snapped to real roads at build time (scripts/snap_roads.mjs); a leg the build
// missed is snapped in the browser when a public router answers.
// Optional `regions` (GeoJSON, e.g. prefectures visited) and `pois` (points with a `layer` name, e.g. manhole covers)
// become overlays in the layer control; regions and point layers start off.
// `bands` (wide translucent lines for roads called out, e.g. a route driven end to end) start on.
// `global` maps (all destinations at once) say "bullet train" instead of "Shinkansen" (Patrick, Oct 2026).
const { stops, legs: rawLegs = [], global = false, height = 460, dot = 8, groups = [], lines = true, regions = null, regionsLabel = 'Prefectures visited', pois = [], bands = [] } = Astro.props;
const legs = global ? rawLegs.map((l: any) => ({ ...l, name: l.name?.replace(/Shinkansen/g, 'bullet train') })) : rawLegs;
const used = new Set(legs.length ? legs.map((l: any) => l.mode) : stops.map((s: any) => s.mode));
const legend = [
  ['drive', 'Drive'], ['shinkansen', 'Shinkansen'], ['express', 'Limited express'], ['local', 'Local train'], ['daytrip', 'Day trip'], ['bus', 'Bus'], ['ferry', 'Boat / ferry'],
  ['train', 'Getting around town'], ['flight', 'Flight'],
].filter(([m]) => used.has(m)).map(([m, label]) => [m, global && m === 'shinkansen' ? 'Bullet train' : label]);
---
{groups.length > 1 && (
  <div class="map-filter" role="group" aria-label="Filter the map">
    <button type="button" class="all" aria-pressed="true">All</button>
    {groups.map((g: string) => <button type="button" data-group={g} aria-pressed="true">{g}</button>)}
  </div>
)}
<div class="route-map" data-base={import.meta.env.BASE_URL.replace(/\/$/, '')} style={`height: ${height}px`} data-dot={dot} data-stops={JSON.stringify(stops)} data-legs={JSON.stringify(legs)} data-lines={String(lines)}
  data-regions={regions ? JSON.stringify(regions) : ''} data-regions-label={regionsLabel} data-pois={JSON.stringify(pois)} data-bands={JSON.stringify(bands)}></div>
<ul class="legend">{legend.map(([m, label]) => <li class={m}>{label}</li>)}</ul>
<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { roadQuery, roadKey } from '../lib/road-key';
  const styles: Record<string, L.PolylineOptions> = {
    drive: { color: '#7c3aed', weight: 4 },
    shinkansen: { color: '#dc2626', weight: 5 },
    express: { color: '#2563eb', weight: 4 },
    local: { color: '#16a34a', weight: 3 },
    daytrip: { color: '#0d9488', weight: 3, dashArray: '8 6' },
    bus: { color: '#d97706', weight: 3 },
    ferry: { color: '#0891b2', weight: 3, dashArray: '4 6' },
    train: { color: '#6b7280', weight: 2, dashArray: '6 6' },
    flight: { color: '#6b665e', weight: 2, dashArray: '2 6' },
    walk: { color: '#16a34a', weight: 3 },
    other: { color: '#6b665e', weight: 3 },
  };
  // Roads snapped at build time come first. Otherwise public OSRM routers are tried in order and the result is
  // cached per browser; on failure the waypoint line stays.
  const routers = [
    'https://routing.openstreetmap.de/routed-car/route/v1/driving/',
    'https://router.project-osrm.org/route/v1/driving/',
  ];
  const base = document.querySelector<HTMLElement>('.route-map')?.dataset.base ?? '';
  // Asking the public routers goes one request at a time, to stay polite.
  let queue: Promise<unknown> = Promise.resolve();
  async function roadLine(coords: [number, number][]): Promise<[number, number][] | null> {
    const q = roadQuery(coords);
    if (!q) return null;
    try {
      const res = await fetch(`${base}/roads/${roadKey(q)}.json`);
      if (res.ok) return await res.json();
    } catch {}
    const p = queue.then(() => askRouters(q));
    queue = p.catch(() => null);
    return p;
  }
  async function askRouters(q: string): Promise<[number, number][] | null> {
    const key = 'road:' + q;
    try { const hit = localStorage.getItem(key); if (hit) return JSON.parse(hit); } catch {}
    for (const r of routers) {
      try {
        const res = await fetch(`${r}${q}?overview=full&geometries=geojson`);
        if (!res.ok) continue;
        const data = await res.json();
        const line = data.routes?.[0]?.geometry?.coordinates?.map(([lng, lat]: number[]) => [lat, lng]);
        if (!line?.length) continue;
        try { localStorage.setItem(key, JSON.stringify(line)); } catch {}
        return line;
      } catch {}
    }
    return null;
  }
  document.querySelectorAll<HTMLElement>('.route-map').forEach((el) => {
    const stops = JSON.parse(el.dataset.stops || '[]');
    const legs = JSON.parse(el.dataset.legs || '[]');
    if (!stops.length) { el.innerHTML = '<p class="empty">Route map coming soon.</p>'; return; }
    const map = L.map(el, { scrollWheelZoom: false, zoomSnap: 0.25 });
    const streets = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© OpenStreetMap contributors' }).addTo(map);
    const satellite = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { maxZoom: 19, attribution: 'Imagery © Esri, Maxar, Earthstar Geographics' });
    const overlays: Record<string, L.Layer> = {};
    // host = where a layer lives (the map, or an overlay group the layer control can switch off).
    const layers: { groups?: string[]; layer: L.Layer; host?: L.LayerGroup }[] = [];
    if (el.dataset.regions) {
      map.createPane('regions').style.zIndex = '350'; // under the route lines
      const shaded = L.layerGroup();
      JSON.parse(el.dataset.regions).features.forEach((f: any) => {
        const layer = L.geoJSON(f, { style: { color: '#c2410c', weight: 1, fillColor: '#f97316', fillOpacity: .18 }, pane: 'regions' })
          .bindTooltip(`${f.properties.name}${f.properties.note ? ` · ${f.properties.note}` : ''}`, { sticky: true });
        layer.addTo(shaded);
        layers.push({ groups: f.properties.groups, layer, host: shaded });
      });
      overlays[el.dataset.regionsLabel || 'Regions'] = shaded;
    }
    // Bands: wide translucent lines under the route for roads worth calling out, shown by default and snapped to roads.
    const bands = JSON.parse(el.dataset.bands || '[]');
    if (bands.length) map.createPane('bands').style.zIndex = '390';
    bands.forEach((b: any) => {
      const line = L.polyline(b.coords, { color: b.color, weight: 14, opacity: .35, lineCap: 'round', pane: 'bands' }).bindTooltip(b.name, { sticky: true });
      overlays[b.name] = L.layerGroup([line]).addTo(map);
      roadLine(b.coords).then((road) => { if (road) line.setLatLngs(road); });
    });
    const pois = JSON.parse(el.dataset.pois || '[]');
    // Highlighted points get a label unless a stop already names the town; labels point away from the middle of
    // the map so they stay clear of the route.
    const named = new Set(stops.map((s: any) => s.name));
    // In a layer with highlighted points, the rest are drawn smaller and paler.
    const highlighted = new Set(pois.filter((p: any) => p.highlight).map((p: any) => p.layer));
    const midLng = stops.reduce((a: number, s: any) => a + s.lng, 0) / Math.max(stops.length, 1);
    pois.forEach((p: any) => {
      const label = p.highlight && !named.has(p.name);
      const dir = label && p.lng < midLng ? 'left' : 'right';
      const group = (overlays[p.layer] as L.LayerGroup) ?? (overlays[p.layer] = L.layerGroup());
      L.marker([p.lat, p.lng], { icon: p.highlight ? L.divIcon({ className: 'poi-marker poi-highlight', iconSize: [16, 16] })
        : highlighted.has(p.layer) ? L.divIcon({ className: 'poi-marker poi-minor', iconSize: [11, 11] })
        : L.divIcon({ className: 'poi-marker', iconSize: [16, 16] }), zIndexOffset: 500 })
        .bindPopup(`<strong>${p.name}</strong>${p.date ? `<br>${p.date}` : ''}${p.note ? `<br>${p.note}` : ''}`)
        .bindTooltip(label ? p.name.replace(/ \(.*\)$/, '') : p.name, label ? { permanent: true, direction: dir, offset: [dir === 'left' ? -8 : 8, 0], className: 'poi-label' } : { direction: 'top', offset: [0, -8] })
        .addTo(group as L.LayerGroup);
    });
    L.control.layers({ Map: streets, Satellite: satellite }, overlays, { position: 'topright' }).addTo(map);
    legs.forEach((leg: any) => {
      const line = L.polyline(leg.coords, styles[leg.mode] ?? styles.other).bindTooltip(leg.name).addTo(map);
      layers.push({ groups: leg.groups, layer: line });
      if (leg.mode === 'drive') roadLine(leg.coords).then((road) => { if (road) line.setLatLngs(road); });
    });
    // Without legs, connect the stops in order with straight lines.
    if (!legs.length && el.dataset.lines !== 'false') stops.forEach((s: any, i: number) => {
      if (i > 0) L.polyline([[stops[i - 1].lat, stops[i - 1].lng], [s.lat, s.lng]], styles[s.mode] ?? styles.other).addTo(map);
    });
    const labelled: any[] = [];
    stops.forEach((s: any, i: number) => {
      const marker = L.circleMarker([s.lat, s.lng], { radius: Number(el.dataset.dot || 8), color: '#fff', weight: 1.5, fillColor: '#c2410c', fillOpacity: .95 })
        .bindPopup(`<strong>${s.name}</strong>${s.date ? `<br>${s.date}` : ''}${s.note ? `<br>${s.note}` : ''}`)
        .bindTooltip(s.name, { permanent: stops.length <= 12, direction: 'right', offset: [8, 0], className: 'stop-label' })
        .addTo(map);
      layers.push({ groups: s.groups, layer: marker });
      if (stops.length <= 12) labelled.push(marker);
    });
    // Hide a stop label that would overlap an earlier one (stops are listed main cities first); it comes back on zoom or hover.
    const declutter = () => {
      const kept: DOMRect[] = [];
      labelled.forEach((m) => {
        const t = m.getTooltip()?.getElement();
        if (!t || !map.hasLayer(m)) return;
        t.style.visibility = '';
        const r = t.getBoundingClientRect();
        if (kept.some((k) => r.left < k.right && r.right > k.left && r.top < k.bottom && r.bottom > k.top)) t.style.visibility = 'hidden';
        else kept.push(r);
      });
    };
    labelled.forEach((m) => m.on('mouseover', () => { const t = m.getTooltip()?.getElement(); if (t) t.style.visibility = ''; }));
    map.on('zoomend', declutter);
    // Year or destination toggles: a layer shows while any of its groups is switched on, and the map refits to it.
    const filter = el.previousElementSibling?.classList.contains('map-filter') ? el.previousElementSibling : null;
    if (filter) {
      const buttons = [...filter.querySelectorAll<HTMLButtonElement>('button[data-group]')];
      const allButton = filter.querySelector<HTMLButtonElement>('button.all')!;
      const apply = () => {
        const on = new Set(buttons.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.group));
        allButton.setAttribute('aria-pressed', String(on.size === buttons.length));
        layers.forEach(({ groups, layer, host }) => {
          const show = !groups || groups.some((g) => on.has(g));
          const h = host ?? map;
          if (show && !h.hasLayer(layer)) h.addLayer(layer);
          if (!show && h.hasLayer(layer)) h.removeLayer(layer);
        });
        // Zoom to what is left on the map; with nothing selected, keep the current view.
        const shown = stops.filter((s: any) => !s.groups || s.groups.some((g: string) => on.has(g)));
        if (shown.length) map.flyToBounds(L.latLngBounds(shown.map((s: any) => [s.lat, s.lng])), { padding: [30, 30], maxZoom: 9, duration: .6 });
      };
      buttons.forEach((b) => b.addEventListener('click', () => {
        b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
        apply();
      }));
      allButton.addEventListener('click', () => { buttons.forEach((b) => b.setAttribute('aria-pressed', 'true')); apply(); });
    }
    map.fitBounds(L.latLngBounds(stops.map((s: any) => [s.lat, s.lng])), { padding: [30, 30] });
    declutter();
  });
</script>
<style>
  .map-filter { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 12px; }
  .map-filter button { font: inherit; font-size: .9rem; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); color: var(--muted); cursor: pointer; }
  .map-filter button[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
  .route-map { border-radius: 14px; border: 1px solid var(--border); background: var(--surface); }
  .legend { display: flex; flex-wrap: wrap; gap: 18px; list-style: none; padding: 0; margin: 8px 0 0; font-size: .85rem; color: var(--muted); }
  .legend li::before { content: ''; display: inline-block; width: 22px; margin-right: 6px; vertical-align: middle; border-top: 3px solid; }
  .legend .drive::before { border-color: #7c3aed; }
  .legend .shinkansen::before { border-color: #dc2626; border-top-width: 4px; }
  .legend .express::before { border-color: #2563eb; }
  .legend .local::before { border-color: #16a34a; }
  .legend .daytrip::before { border-color: #0d9488; border-top-style: dashed; }
  .legend .bus::before { border-color: #d97706; }
  .legend .ferry::before { border-color: #0891b2; border-top-style: dashed; }
  .legend .train::before { border-color: #6b7280; border-top-style: dashed; }
  .legend .flight::before { border-color: #6b665e; border-top-style: dotted; }
  :global(.route-map .stop-label) { background: transparent; border: 0; box-shadow: none; font-weight: 600; color: #1f1d1a; text-shadow: 0 0 3px #fff, 0 0 3px #fff; }
  :global(.route-map .stop-label::before) { display: none; }
  :global(.route-map .poi-marker) { width: 16px; height: 16px; border-radius: 50%; background: #374151; border: 3px solid #fbbf24; box-shadow: 0 0 0 1.5px #fff; box-sizing: border-box; }
  :global(.route-map .poi-highlight) { background: #fbbf24; border-color: #92400e; }
  :global(.route-map .poi-minor) { width: 11px; height: 11px; border-width: 2px; background: #fef3c7; border-color: #d97706; }
  :global(.route-map .poi-label) { background: #fef3c7; border-color: #f59e0b; color: #78350f; font-weight: 600; font-size: .75rem; padding: 1px 6px; box-shadow: none; }
  :global(.route-map .poi-label::before) { display: none; }
  :global(.route-map .empty) { padding: 24px; color: var(--muted); }
</style>
