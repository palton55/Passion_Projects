---
// Road map: stops are the places visited. Optional `legs` draw the real route (e.g. rail lines);
// without legs, stops are joined in order by straight lines.
// Optional `groups` (e.g. years) add toggle buttons; legs and stops then carry `groups: string[]`.
// Drive legs are photo-GPS waypoints; the browser snaps them to real roads when a router answers.
const { stops, legs = [], height = 460, dot = 8, groups = [], lines = true } = Astro.props;
const used = new Set(legs.length ? legs.map((l: any) => l.mode) : stops.map((s: any) => s.mode));
const legend = [
  ['drive', 'Drive'], ['shinkansen', 'Shinkansen'], ['express', 'Limited express'], ['local', 'Local train'], ['daytrip', 'Day trip'], ['bus', 'Bus'], ['ferry', 'Boat / ferry'],
  ['train', 'Getting around town'], ['flight', 'Flight'],
].filter(([m]) => used.has(m));
---
{groups.length > 1 && (
  <div class="map-filter" role="group" aria-label="Filter the map">
    <button type="button" class="all" aria-pressed="true">All</button>
    {groups.map((g: string) => <button type="button" data-group={g} aria-pressed="true">{g}</button>)}
  </div>
)}
<div class="route-map" style={`height: ${height}px`} data-dot={dot} data-stops={JSON.stringify(stops)} data-legs={JSON.stringify(legs)} data-lines={String(lines)}></div>
<ul class="legend">{legend.map(([m, label]) => <li class={m}>{label}</li>)}</ul>
<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  const styles: Record<string, L.PolylineOptions> = {
    drive: { color: '#7c3aed', weight: 4 },
    shinkansen: { color: '#dc2626', weight: 5 },
    express: { color: '#2563eb', weight: 4 },
    local: { color: '#16a34a', weight: 3 },
    daytrip: { color: '#0d9488', weight: 3, dashArray: '8 6' },
    bus: { color: '#d97706', weight: 3 },
    ferry: { color: '#0891b2', weight: 3, dashArray: '4 6' },
    train: { color: '#6b7280', weight: 2, dashArray: '6 6' },
    flight: { color: '#6b665e', weight: 2, dashArray: '2 6' },
    walk: { color: '#16a34a', weight: 3 },
    other: { color: '#6b665e', weight: 3 },
  };
  // Public OSRM routers, tried in order. Results are cached per browser; on failure the waypoint line stays.
  const routers = [
    'https://routing.openstreetmap.de/routed-car/route/v1/driving/',
    'https://router.project-osrm.org/route/v1/driving/',
  ];
  // One request at a time, to stay polite to the public routers.
  let queue: Promise<unknown> = Promise.resolve();
  const queued = (coords: [number, number][]) => { const p = queue.then(() => roadRoute(coords)); queue = p.catch(() => null); return p; };
  async function roadRoute(coords: [number, number][]): Promise<[number, number][] | null> {
    const pts = coords.filter((c, i) => i === 0 || Math.abs(c[0] - coords[i - 1][0]) + Math.abs(c[1] - coords[i - 1][1]) > 0.002);
    if (pts.length < 2) return null;
    const q = pts.map(([lat, lng]) => `${lng.toFixed(5)},${lat.toFixed(5)}`).join(';');
    const key = 'road:' + q;
    try { const hit = localStorage.getItem(key); if (hit) return JSON.parse(hit); } catch {}
    for (const r of routers) {
      try {
        const res = await fetch(`${r}${q}?overview=full&geometries=geojson`);
        if (!res.ok) continue;
        const data = await res.json();
        const line = data.routes?.[0]?.geometry?.coordinates?.map(([lng, lat]: number[]) => [lat, lng]);
        if (!line?.length) continue;
        try { localStorage.setItem(key, JSON.stringify(line)); } catch {}
        return line;
      } catch {}
    }
    return null;
  }
  document.querySelectorAll<HTMLElement>('.route-map').forEach((el) => {
    const stops = JSON.parse(el.dataset.stops || '[]');
    const legs = JSON.parse(el.dataset.legs || '[]');
    if (!stops.length) { el.innerHTML = '<p class="empty">Route map forthcoming.</p>'; return; }
    const map = L.map(el, { scrollWheelZoom: false });
    const streets = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© OpenStreetMap contributors' }).addTo(map);
    const satellite = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { maxZoom: 19, attribution: 'Imagery © Esri, Maxar, Earthstar Geographics' });
    L.control.layers({ Map: streets, Satellite: satellite }, undefined, { position: 'topright' }).addTo(map);
    const layers: { groups?: string[]; layer: L.Layer }[] = [];
    legs.forEach((leg: any) => {
      const line = L.polyline(leg.coords, styles[leg.mode] ?? styles.other).bindTooltip(leg.name).addTo(map);
      layers.push({ groups: leg.groups, layer: line });
      if (leg.mode === 'drive') queued(leg.coords).then((road) => { if (road) line.setLatLngs(road); });
    });
    // Without legs, connect the stops in order with straight lines.
    if (!legs.length && el.dataset.lines !== 'false') stops.forEach((s: any, i: number) => {
      if (i > 0) L.polyline([[stops[i - 1].lat, stops[i - 1].lng], [s.lat, s.lng]], styles[s.mode] ?? styles.other).addTo(map);
    });
    stops.forEach((s: any, i: number) => {
      const marker = L.circleMarker([s.lat, s.lng], { radius: Number(el.dataset.dot || 8), color: '#fff', weight: 1.5, fillColor: '#c2410c', fillOpacity: .95 })
        .bindPopup(`<strong>${s.name}</strong>${s.date ? `<br>${s.date}` : ''}${s.note ? `<br>${s.note}` : ''}`)
        .bindTooltip(s.name, { permanent: stops.length <= 12, direction: 'right', offset: [8, 0], className: 'stop-label' })
        .addTo(map);
      layers.push({ groups: s.groups, layer: marker });
    });
    // Year toggles: a layer shows while any of its groups is switched on.
    const filter = el.previousElementSibling?.classList.contains('map-filter') ? el.previousElementSibling : null;
    if (filter) {
      const buttons = [...filter.querySelectorAll<HTMLButtonElement>('button[data-group]')];
      const allButton = filter.querySelector<HTMLButtonElement>('button.all')!;
      const apply = () => {
        const on = new Set(buttons.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.group));
        allButton.setAttribute('aria-pressed', String(on.size === buttons.length));
        layers.forEach(({ groups, layer }) => {
          const show = !groups || groups.some((g) => on.has(g));
          if (show && !map.hasLayer(layer)) layer.addTo(map);
          if (!show && map.hasLayer(layer)) map.removeLayer(layer);
        });
      };
      buttons.forEach((b) => b.addEventListener('click', () => {
        b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
        apply();
      }));
      allButton.addEventListener('click', () => { buttons.forEach((b) => b.setAttribute('aria-pressed', 'true')); apply(); });
    }
    map.fitBounds(L.latLngBounds(stops.map((s: any) => [s.lat, s.lng])), { padding: [30, 30] });
  });
</script>
<style>
  .map-filter { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 12px; }
  .map-filter button { font: inherit; font-size: .9rem; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); color: var(--muted); cursor: pointer; }
  .map-filter button[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
  .route-map { border-radius: 14px; border: 1px solid var(--border); background: var(--surface); }
  .legend { display: flex; flex-wrap: wrap; gap: 18px; list-style: none; padding: 0; margin: 8px 0 0; font-size: .85rem; color: var(--muted); }
  .legend li::before { content: ''; display: inline-block; width: 22px; margin-right: 6px; vertical-align: middle; border-top: 3px solid; }
  .legend .drive::before { border-color: #7c3aed; }
  .legend .shinkansen::before { border-color: #dc2626; border-top-width: 4px; }
  .legend .express::before { border-color: #2563eb; }
  .legend .local::before { border-color: #16a34a; }
  .legend .daytrip::before { border-color: #0d9488; border-top-style: dashed; }
  .legend .bus::before { border-color: #d97706; }
  .legend .ferry::before { border-color: #0891b2; border-top-style: dashed; }
  .legend .train::before { border-color: #6b7280; border-top-style: dashed; }
  .legend .flight::before { border-color: #6b665e; border-top-style: dotted; }
  :global(.route-map .stop-label) { background: transparent; border: 0; box-shadow: none; font-weight: 600; color: #1f1d1a; text-shadow: 0 0 3px #fff, 0 0 3px #fff; }
  :global(.route-map .stop-label::before) { display: none; }
  :global(.route-map .empty) { padding: 24px; color: var(--muted); }
</style>
