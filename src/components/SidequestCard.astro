---
const { entry } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const d = entry.data;
const fmt = (x: Date) => x.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<a class="card" href={`${base}/sidequests/${entry.id}/`}>
  <div class="cover" style={d.cover ? `background-image:url(${base}/${d.cover})` : ''}>
    {!d.cover && <span>{d.category}</span>}
  </div>
  <div class="body">
    <p class="meta">{[d.category, d.region, d.start && fmt(d.start)].filter(Boolean).join(' · ')}</p>
    <h3>{d.title}</h3>
    <p>{d.summary}</p>
  </div>
</a>
<style>
  .card { display: block; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; text-decoration: none; color: var(--text); transition: transform .15s; }
  .card:hover { transform: translateY(-3px); }
  .cover { aspect-ratio: 16/10; background: var(--unvisited) center/cover; display: grid; place-items: center; color: var(--muted); font-family: Fraunces, serif; font-size: 1.3rem; }
  .body { padding: 16px 18px 20px; }
  .meta { color: var(--muted); font-size: .85rem; margin: 0; }
  h3 { margin: 4px 0 8px; font-size: 1.25rem; }
  .body p:last-child { margin: 0; color: var(--muted); font-size: .95rem; }
</style>
