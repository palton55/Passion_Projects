---
// `image` (a path under public, e.g. "photos/japan-2023/01.jpg") is the photo shown when a link to the page is shared.
interface Props { title: string; description?: string; image?: string }
const { title, description = 'A curated record of travel, training, and other sidequests.', image = 'photos/japan-2026/06.jpg' } = Astro.props;
import { isAlpha } from '../lib/drafts';
import { photoUrl } from '../lib/img';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const shareImage = new URL(photoUrl(image, 960), Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en" data-font={isAlpha ? 'grotesk' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isAlpha ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sidequest Resume" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta name="theme-color" content="#c2410c" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    {isAlpha && <div class="alpha-banner">Alpha preview. This version includes unpublished drafts.</div>}
    <header class="site-header">
      {/* The home page's own heading names the site, so the brand link is left off there. */}
      {Astro.url.pathname.replace(/\/$/, '') !== base && <a class="brand" href={`${base}/`}>Sidequest Resume</a>}
      <nav>
        <a href={`${base}/travel/`}>Travel</a>
        <a href={`${base}/pursuits/`}>Pursuits</a>
        <a href={`${base}/about/`}>About</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">Sidequest Resume is in an early alpha stage of development. Content, layout, and features are subject to change as entries are added.</footer>
  </body>
</html>
<style is:global>
  /* Heading font. The alpha is trialling Space Grotesk (Oct 2026). */
  :root { --font-head: Fraunces, Georgia, serif; }
  :root[data-font="grotesk"] { --font-head: "Space Grotesk", system-ui, sans-serif; }
  :root {
    --bg: #faf7f2; --surface: #ffffff; --text: #1f1d1a; --muted: #6b665e;
    --accent: #c2410c; --border: #e7e1d7; --visited: #c2410c; --unvisited: #e7e1d7;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161513; --surface: #201e1b; --text: #f2eee8; --muted: #a39d93;
      --accent: #fb923c; --border: #34312c; --visited: #fb923c; --unvisited: #34312c;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 17px/1.65 Inter, system-ui, sans-serif; }
  h1, h2, h3 { font-family: var(--font-head); line-height: 1.2; }
  a { color: var(--accent); }
  main { max-width: 1040px; margin: 0 auto; padding: 0 16px 64px; }
  .site-header { display: flex; justify-content: space-between; align-items: center; max-width: 1040px; margin: 0 auto; padding: 20px 16px; flex-wrap: wrap; gap: 12px; }
  .brand { font-family: var(--font-head); font-weight: 700; font-size: 1.4rem; color: var(--text); text-decoration: none; }
  nav { display: flex; gap: 20px; margin-left: auto; }
  nav a { color: var(--text); text-decoration: none; font-weight: 500; }
  nav a:hover { color: var(--accent); }
  .site-footer { text-align: center; color: var(--muted); padding: 32px 16px; border-top: 1px solid var(--border); font-size: .9rem; }
  img { max-width: 100%; height: auto; display: block; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* Phones: brand and menu share one line. */
  @media (max-width: 480px) {
    .site-header { padding: 12px 16px; flex-wrap: nowrap; }
    .brand { font-size: 1.1rem; white-space: nowrap; }
    nav { gap: 14px; }
    nav a { font-size: .95rem; padding: 6px 0; }
  }
  .alpha-banner { background: var(--accent); color: #fff; text-align: center; padding: 6px 16px; font-size: .85rem; font-weight: 600; }
</style>
