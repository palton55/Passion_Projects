---
import Base from '../../../layouts/Base.astro';
import Tile from '../../../components/Tile.astro';
import RouteMap from '../../../components/RouteMap.astro';
import { oahuSections, areaOf, placeName } from '../../../data/oahu';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ready = oahuSections.filter((s) => s.list);
const soon = oahuSections.filter((s) => !s.list);
// Everything from the synced lists on one map, toggled by kind.
const dots = ready.flatMap((s) => s.list!.places.map((p) => ({ name: placeName(p), lat: p.lat, lng: p.lng, date: s.name, note: areaOf(p.lat, p.lng), groups: [s.name] })));
---
<Base title="Oahu · Sidequest Resume" description="My favorite food, beaches, hikes, and day trips on Oahu, from four years of living here.">
  <p class="crumb"><a href={`${base}/travel/`}>Travel</a> / <a href={`${base}/hawaii/`}>Hawaii</a></p>
  <h1>Oahu</h1>
  <p class="lede">I've lived on Oahu for four years while at university, so this isn't one trip. It's a running collection of the places I recommend: where to eat, the beaches and hikes I keep going back to, and the day trips worth making around the island.</p>
  <div class="grid">
    {ready.map((s) => <Tile href={`/hawaii/oahu/${s.slug}/`} title={s.name} meta={`${s.list!.places.length} places`} blurb={s.blurb} />)}
  </div>
  {dots.length > 0 && (
    <section class="topic">
      <h2>Map</h2>
      <RouteMap stops={dots} height={480} dot={5} lines={false} groups={ready.length > 1 ? ready.map((s) => s.name) : []} />
    </section>
  )}
  {soon.length > 0 && (
    <section class="topic">
      <h2>Coming Soon</h2>
      <ul class="soon">{soon.map((s) => <li><strong>{s.name}.</strong> {s.blurb}</li>)}</ul>
    </section>
  )}
</Base>
<style>
  .crumb { color: var(--muted); font-size: .9rem; margin: 0 0 8px; }
  .lede { font-size: 1.1rem; max-width: 680px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin: 24px 0; }
  .topic { border-top: 1px solid var(--border); margin-top: 32px; }
  .soon { padding-left: 20px; color: var(--muted); }
</style>
