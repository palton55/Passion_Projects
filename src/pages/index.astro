---
import Base from '../layouts/Base.astro';
import SidequestCard from '../components/SidequestCard.astro';
import Carousel from '../components/Carousel.astro';
import covers from '../data/covers.json';
import { showDrafts } from '../lib/drafts';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = (await getCollection('adventures', ({ data }) => !data.draft || showDrafts))
  .sort((a, b) => (b.data.start?.valueOf() ?? 0) - (a.data.start?.valueOf() ?? 0));
const slides = all.flatMap((e) => {
  const src = e.data.cover ?? (covers as Record<string, string>)[e.id];
  return src ? [{ href: `${base}/sidequests/${e.id}/`, src, title: e.data.title, meta: e.data.start?.getUTCFullYear().toString() }] : [];
});
---
<Base title="Sidequest Resume">
  <section class="hero">
    <h1>Sidequest Resume</h1>
    <p>A curated record of notable experiences from the past few years, laid out like a resume. It covers travel, training, competition, and photography, with routes, timelines, and photos for each.</p>
    <a class="cta" href={`${base}/travel/`}>Travel</a>
    <a class="cta" href={`${base}/pursuits/`}>Pursuits</a>
    <a class="cta" href={`${base}/maps/`}>Maps</a>
  </section>
  <Carousel slides={slides} />
  <h2>Recent sidequests</h2>
  {all.length === 0 && <p class="empty">Entries coming soon.</p>}
  <div class="grid">{all.slice(0, 6).map((entry) => <SidequestCard entry={entry} />)}</div>
</Base>
<style>
  .hero { padding: 48px 0 32px; max-width: 680px; }
  .hero h1 { font-size: clamp(2.2rem, 6vw, 3.4rem); margin: 0 0 16px; }
  .hero p { color: var(--muted); font-size: 1.1rem; }
  @media (max-width: 480px) { .hero { padding: 16px 0 24px; } }
  .cta { display: inline-block; margin: 8px 8px 0 0; padding: 10px 18px; border-radius: 999px; background: var(--accent); color: #fff; text-decoration: none; font-weight: 600; }
  .empty { color: var(--muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
</style>
