---
import Base from '../layouts/Base.astro';
import SidequestCard from '../components/SidequestCard.astro';
import { showDrafts } from '../lib/drafts';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = (await getCollection('adventures', ({ data }) => !data.draft || showDrafts))
  .sort((a, b) => b.data.start.valueOf() - a.data.start.valueOf());
---
<Base title="Sidequest Resume">
  <section class="hero">
    <h1>Sidequest Resume</h1>
    <p>A curated record of travels, road trips, dives, and the detours along the way. The collection begins with Japan, where I have spent most of my adult life, and will expand to destinations beyond it.</p>
    <a class="cta" href={`${base}/sidequests/`}>View all sidequests</a>
  </section>
  <h2>Recent sidequests</h2>
  {all.length === 0 && <p class="empty">Entries are currently in preparation.</p>}
  <div class="grid">{all.slice(0, 6).map((entry) => <SidequestCard entry={entry} />)}</div>
</Base>
<style>
  .hero { padding: 48px 0 32px; max-width: 680px; }
  .hero h1 { font-size: clamp(2.2rem, 6vw, 3.4rem); margin: 0 0 16px; }
  .hero p { color: var(--muted); font-size: 1.1rem; }
  .cta { display: inline-block; margin-top: 8px; padding: 10px 18px; border-radius: 999px; background: var(--accent); color: #fff; text-decoration: none; font-weight: 600; }
  .empty { color: var(--muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
</style>
