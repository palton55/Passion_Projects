---
import Base from '../layouts/Base.astro';
import SidequestCard from '../components/SidequestCard.astro';
import { visited } from '../data/visited';
import { showDrafts } from '../lib/drafts';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const count = Object.keys(visited).length;
const entries = (await getCollection('adventures', ({ data }) => data.region === 'Japan' && (!data.draft || showDrafts)))
  .sort((a, b) => (a.data.start?.valueOf() ?? 0) - (b.data.start?.valueOf() ?? 0));
---
<Base title="Japan · Sidequest Resume" description="Sidequests in Japan and a map of the prefectures visited.">
  <h1>Japan</h1>
  <p class="lede">Japan is where I have spent the most time as an adult, across short trips and a six-month study abroad. This section collects those sidequests.</p>
  <h2>Prefectures visited</h2>
  <p class="meta">{count} of 47 prefectures visited. Select a prefecture to see the sidequests that included it.</p>
  <div id="pref-map" data-visited={JSON.stringify(visited)} data-base={base}></div>
  <h2>Sidequests in Japan</h2>
  {entries.length === 0 && <p class="meta">Entries are currently in preparation.</p>}
  <div class="grid">{entries.map((entry) => <SidequestCard entry={entry} />)}</div>
</Base>
<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  const el = document.getElementById('pref-map')!;
  const visited = JSON.parse(el.dataset.visited!);
  const base = el.dataset.base!;
  const css = getComputedStyle(document.documentElement);
  const map = L.map(el, { scrollWheelZoom: false }).setView([37.5, 137.5], 5);
  L.tileLayer('https://{s}.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}{r}.png', { attribution: '© OpenStreetMap, © CARTO' }).addTo(map);
  fetch(`${base}/japan-prefectures.geojson`).then((r) => r.json()).then((geo) => {
    L.geoJSON(geo, {
      style: (f: any) => {
        const on = visited[f.properties.nam] !== undefined;
        return { color: '#fff', weight: 1, fillOpacity: on ? .85 : .5, fillColor: on ? css.getPropertyValue('--visited') : css.getPropertyValue('--unvisited') };
      },
      onEachFeature: (f: any, layer) => {
        const v = visited[f.properties.nam];
        const links = v?.trips?.map((t: string) => `<a href="${base}/sidequests/${t}/">${t}</a>`).join('<br>');
        layer.bindPopup(`<strong>${f.properties.nam}</strong><br>${v ? (links || 'Visited') : 'Not yet visited'}`);
      },
    }).addTo(map);
  });
</script>
<style>
  #pref-map { height: 640px; border-radius: 14px; border: 1px solid var(--border); margin-top: 16px; }
  .meta { color: var(--muted); }
  .lede { font-size: 1.1rem; max-width: 680px; }
  h2 { margin-top: 40px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
</style>
