---
// Every road and rail line from the Japan entries on one map. It is built from the entries,
// so each new entry with route legs appears here automatically.
import Base from '../../layouts/Base.astro';
import RouteMap from '../../components/RouteMap.astro';
import { showDrafts } from '../../lib/drafts';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = (await getCollection('adventures', ({ data }) => data.region === 'Japan' && (!data.draft || showDrafts)))
  .sort((a, b) => (a.data.start?.valueOf() ?? 0) - (b.data.start?.valueOf() ?? 0));
// Roads and rail only: flights and the straight day-trip lines are not routes on the ground.
const skip = new Set(['flight', 'daytrip']);
const year = (e: (typeof entries)[number]) => String(e.data.start?.getUTCFullYear() ?? '');
const legs = entries.flatMap((e) => e.data.legs.filter((l) => !skip.has(l.mode))
  .map((l) => ({ ...l, name: `${e.data.title}: ${l.name}`, groups: [year(e)] })));
// One dot per place; a place visited in several years belongs to each of them.
const byName = new Map<string, any>();
for (const e of entries) for (const s of e.data.stops) {
  const prev = byName.get(s.name);
  if (prev) { if (!prev.groups.includes(year(e))) prev.groups.push(year(e)); prev.date += `, ${e.data.title}`; }
  else byName.set(s.name, { ...s, date: e.data.title, groups: [year(e)] });
}
const stops = [...byName.values()];
const mapped = entries.filter((e) => e.data.legs.some((l) => !skip.has(l.mode)));
const years = [...new Set(mapped.map(year))].sort();
---
<Base title="Japan Route Map · Sidequest Resume" description="Every road and rail line travelled in Japan, combined on one map.">
  <p class="crumb"><a href={`${base}/travel/`}>Experience</a> / <a href={`${base}/japan/`}>Japan</a></p>
  <h1>Routes Across Japan</h1>
  <p class="lede">Every road driven and rail line ridden across the Japan entries, combined on one map. Use the year buttons to show or hide each year, and hover over a line to see which trip it belongs to.</p>
  <p class="meta">{mapped.length} {mapped.length === 1 ? 'entry' : 'entries'} · {legs.length} routes</p>
  <RouteMap stops={stops} legs={legs} height={720} dot={4} groups={years} />
  {mapped.length > 0 && (
    <>
      <h2>Included entries</h2>
      <ul class="entries">{mapped.map((e) => <li><a href={`${base}/sidequests/${e.id}/`}>{e.data.title}</a></li>)}</ul>
    </>
  )}
</Base>
<style>
  .crumb { color: var(--muted); font-size: .9rem; margin: 0 0 8px; }
  .lede { font-size: 1.1rem; max-width: 680px; }
  .meta { color: var(--muted); }
  h2 { margin-top: 32px; }
  .entries { columns: 2; padding-left: 18px; }
  @media (max-width: 560px) { .entries { columns: 1; } }
</style>
