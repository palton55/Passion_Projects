---
import Base from '../layouts/Base.astro';
import RouteMap from '../components/RouteMap.astro';
import { showDrafts } from '../lib/drafts';
import { getCollection } from 'astro:content';
import { placePages } from '../lib/place-notes';
import PlaceCards from '../components/PlaceCards.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = (await getCollection('adventures', ({ data }) => data.region === 'South Korea' && (!data.draft || showDrafts)))
  .sort((a, b) => (a.data.start?.valueOf() ?? 0) - (b.data.start?.valueOf() ?? 0));
const notes = placePages(entries).filter((p) => p.country === 'South Korea');
const fmt = (x: Date) => x.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Korea · Sidequest Resume" description="Sidequests in South Korea, each with its route map and timeline." image="photos/2025-korea-waterbomb/02.jpg">
  <h1>Korea</h1>
  <p class="lede">So far, my time in South Korea came during my <a href={`${base}/japan/2025/`}>Study Abroad 2025</a> semester in Tokyo: eight days in Seoul in July 2025, with N Seoul Tower and the lanterns at Jogyesa, a tour of the DMZ out to Dora Observatory and Odusan, LoL Park, Gyeongbokgung Palace in hanbok, and the Waterbomb festival in Goyang.</p>
  {entries.length === 0 && <p class="meta pending">Entries coming soon.</p>}
  {entries.map((e) => (
    <section class="topic">
      <h2>{e.data.title}</h2>
      {e.data.start && <p class="meta">{fmt(e.data.start)}{e.data.end && ` to ${fmt(e.data.end)}`}</p>}
      <p>{e.data.summary}</p>
      {e.data.collection === 'Korea and Waterbomb' && <p class="meta">Part of <a href={`${base}/japan/2025/`}>Study Abroad 2025</a></p>}
      {e.data.stops.length > 0 && <RouteMap stops={e.data.stops} legs={e.data.legs} height={420} />}
      <p><a href={`${base}/sidequests/${e.id}/`}>Read the full entry and timeline</a></p>
    </section>
  ))}
  {notes.length > 0 && (
    <section class="topic">
      <h2>Notable Places</h2>
      <PlaceCards places={notes} />
    </section>
  )}
</Base>
<style>
  .meta { color: var(--muted); }
  .lede { font-size: 1.1rem; max-width: 680px; }
  .topic { border-top: 1px solid var(--border); margin-top: 32px; }
  .pending { font-style: italic; }
</style>
