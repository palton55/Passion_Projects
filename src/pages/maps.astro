---
import Base from '../layouts/Base.astro';
import RouteMap from '../components/RouteMap.astro';
import { regions } from '../data/regions';
import { tripMap } from '../lib/trip-map';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { legs, stops, areas } = await tripMap();
// One map per destination that has mapped trips, in the order of the Travel tiles.
const sections = regions.filter((r) => areas.includes(r.name)).map((r) => ({
  region: r,
  stops: stops.filter((s) => s.groups.includes(r.name)),
  legs: legs.filter((l) => l.groups.includes(r.name)),
}));
---
<Base title="Maps · Sidequest Resume" description="Every trip on one map, plus a map for each destination.">
  <h1>Maps</h1>
  <p class="lede">Every trip's stops and routes on one map, followed by a map for each destination. Use the buttons to show or hide a destination, and the switch in the corner for satellite view.</p>
  {stops.length > 0 && <RouteMap stops={stops} legs={legs} height={620} dot={4} groups={areas} lines={false} />}
  {sections.map(({ region, stops, legs }) => (
    <section class="region">
      <h2>{region.name}</h2>
      <RouteMap stops={stops} legs={legs} height={420} dot={5} lines={false} />
      <p class="links">
        <a href={`${base}${region.href ?? `/travel/${region.slug}/`}`}>{region.name} trips</a>
        {region.slug === 'japan' && <a href={`${base}/japan/map/`}>Full Japan route map, with every rail line and drive</a>}
      </p>
    </section>
  ))}
</Base>
<style>
  .lede { color: var(--muted); font-size: 1.1rem; }
  .region { border-top: 1px solid var(--border); margin-top: 32px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 20px; }
</style>
