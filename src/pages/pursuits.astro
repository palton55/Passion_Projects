---
import Base from '../layouts/Base.astro';
import SidequestCard from '../components/SidequestCard.astro';
import { showDrafts } from '../lib/drafts';
import { getCollection } from 'astro:content';
const skills = (await getCollection('adventures', ({ data }) => data.category !== 'Travel' && (!data.draft || showDrafts)))
  .sort((a, b) => a.data.category.localeCompare(b.data.category));
---
<Base title="Pursuits · Sidequest Resume" description="Things I've pursued over the years.">
  <h1>Pursuits</h1>
  <p class="lede">Things I've pursued over the years: scuba diving, Brazilian Jiu-Jitsu, professional esports, drones and photography, and scenic drives.</p>
  {skills.length === 0 && <p class="meta">Entries coming soon.</p>}
  <div class="grid">{skills.map((entry) => <SidequestCard entry={entry} />)}</div>
</Base>
<style>
  .lede { color: var(--muted); font-size: 1.1rem; }
  .meta { color: var(--muted); }
  .toc { display: flex; gap: 16px; margin: 8px 0 8px; }
  .group { border-top: 1px solid var(--border); margin-top: 32px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-bottom: 24px; }
  .region { display: block; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; text-decoration: none; color: var(--text); transition: transform .15s; }
  .region:hover { transform: translateY(-3px); }
  .region .cover { aspect-ratio: 16/10; background: var(--unvisited); display: grid; place-items: center; color: var(--muted); font-family: var(--font-head); font-size: 1.6rem; }
  .region .body { padding: 16px 18px 20px; }
  .region .meta { font-size: .85rem; margin: 0; }
  .region h3 { margin: 4px 0 8px; font-size: 1.25rem; }
  .region .body p:last-child { margin: 0; color: var(--muted); font-size: .95rem; }
</style>
