---
import Base from '../../layouts/Base.astro';
import RouteMap from '../../components/RouteMap.astro';
import Gallery from '../../components/Gallery.astro';
import { showDrafts } from '../../lib/drafts';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const all = await getCollection('adventures', ({ data }) => !data.draft || showDrafts);
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const fmt = (x: Date) => x.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const yt = d.video?.match(/(?:v=|youtu\.be\/)([\w-]{11})/)?.[1];
---
<Base title={`${d.title} · Sidequest Resume`} description={d.summary}>
  <article>
    <p class="meta">{d.collection ?? d.region} · {fmt(d.start)}{d.end && ` to ${fmt(d.end)}`}</p>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    {d.companions.length > 0 && <p class="meta">With {d.companions.join(', ')}</p>}
    {yt && <div class="video"><iframe src={`https://www.youtube-nocookie.com/embed/${yt}`} title={d.title} allowfullscreen loading="lazy"></iframe></div>}
    <h2>The route</h2>
    <RouteMap stops={d.stops} legs={d.legs} />
    <div class="story"><Content /></div>
    {d.photos.length > 0 && <h2>Photos</h2>}
    <Gallery photos={d.photos} />
  </article>
</Base>
<style>
  article { max-width: 760px; margin: 0 auto; }
  h1 { font-size: clamp(2rem, 5vw, 2.8rem); margin: 4px 0 12px; }
  .meta { color: var(--muted); font-size: .9rem; margin: 0; }
  .lede { font-size: 1.15rem; }
  .video { aspect-ratio: 16/9; margin: 24px 0; }
  .video iframe { width: 100%; height: 100%; border: 0; border-radius: 14px; }
  .story { margin-top: 32px; }
</style>
