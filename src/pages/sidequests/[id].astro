---
import Base from '../../layouts/Base.astro';
import RouteMap from '../../components/RouteMap.astro';
import Gallery from '../../components/Gallery.astro';
import Highlights from '../../components/Highlights.astro';
import Timeline from '../../components/Timeline.astro';
import { showDrafts } from '../../lib/drafts';
import { getCollection, render } from 'astro:content';
import { parentOf } from '../../data/japan-topics';
import photoData from '../../data/photos.json';
export async function getStaticPaths() {
  const all = await getCollection('adventures', ({ data }) => !data.draft || showDrafts);
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
// Approved photos live in src/data/photos.json so regenerating entries keeps them.
const photos = d.photos.length ? d.photos : ((photoData as Record<string, { src: string; caption?: string }[]>)[entry.id] ?? []);
const fmt = (x: Date) => x.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const parent = parentOf(d.collection);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const yt = d.video?.match(/(?:v=|youtu\.be\/)([\w-]{11})/)?.[1];
---
<Base title={`${d.title} · Sidequest Resume`} description={d.summary}>
  <article>
    <p class="meta">{[d.category, d.collection ?? d.region, d.start && `${fmt(d.start)}${d.end ? ` to ${fmt(d.end)}` : ''}`].filter(Boolean).join(' · ')}</p>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    {parent && <p class="meta">Part of <a href={`${base}/japan/${parent.page}/`}>{parent.title}</a></p>}
    <Highlights photos={photos} />
    {d.companions.length > 0 && <p class="meta">With {d.companions.join(', ')}</p>}
    {yt && <div class="video"><iframe src={`https://www.youtube-nocookie.com/embed/${yt}`} title={d.title} allowfullscreen loading="lazy"></iframe></div>}
    {d.stops.length > 0 && <h2>The route</h2>}
    {d.stops.length > 0 && <RouteMap stops={d.stops} legs={d.legs} />}
    {d.parts.length === 0 && d.timeline.length > 0 && <h2>Timeline</h2>}
    {d.parts.length === 0 && d.timeline.length > 0 && <Timeline days={d.timeline} />}
    {d.parts.map((part) => (
      <section class="part">
        <h2>{part.title}</h2>
        {part.blurb && <p>{part.blurb}</p>}
        <RouteMap stops={d.stops.filter((s) => part.stops.includes(s.name))} legs={d.legs.filter((l) => part.modes ? part.modes.includes(l.mode) : l.day !== undefined && part.days.includes(l.day))} height={400} />
        <Timeline days={d.timeline.filter((t) => part.days.includes(Number(t.label.replace(/\D/g, ''))))} />
      </section>
    ))}
    <div class="story"><Content /></div>
    {photos.length > 0 && <h2>Photos</h2>}
    <Gallery photos={photos} />
  </article>
</Base>
<style>
  article { max-width: 760px; margin: 0 auto; }
  h1 { font-size: clamp(2rem, 5vw, 2.8rem); margin: 4px 0 12px; }
  .meta { color: var(--muted); font-size: .9rem; margin: 0; }
  .lede { font-size: 1.15rem; }
  .video { aspect-ratio: 16/9; margin: 24px 0; }
  .video iframe { width: 100%; height: 100%; border: 0; border-radius: 14px; }
  .story { margin-top: 32px; }
  .part { border-top: 1px solid var(--border); margin-top: 40px; }
</style>
