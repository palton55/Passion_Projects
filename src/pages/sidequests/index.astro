---
import Base from '../../layouts/Base.astro';
import SidequestCard from '../../components/SidequestCard.astro';
import { showDrafts } from '../../lib/drafts';
import { getCollection } from 'astro:content';
const all = (await getCollection('adventures', ({ data }) => !data.draft || showDrafts))
  .sort((a, b) => (b.data.start?.valueOf() ?? 0) - (a.data.start?.valueOf() ?? 0));
const travel = all.filter((e) => e.data.category === 'Travel');
const hobbies = all.filter((e) => e.data.category !== 'Travel');
const hobbyCategories = [...new Set(hobbies.map((e) => e.data.category))].sort();
---
<Base title="Sidequests · Sidequest Resume">
  <h1>Sidequests</h1>
  <p class="lede">Travel and hobbies, each documented as its own sidequest.</p>
  <nav class="toc"><a href="#travel">Travel</a><a href="#hobbies">Hobbies</a></nav>
  <section id="travel" class="group">
    <h2>Travel</h2>
    <p class="meta">Trips and journeys, most recent first. Japan and Korea also have their own sections with route maps.</p>
    {travel.length === 0 && <p class="meta">Entries are currently in preparation.</p>}
    <div class="grid">{travel.map((entry) => <SidequestCard entry={entry} />)}</div>
  </section>
  <section id="hobbies" class="group">
    <h2>Hobbies</h2>
    <p class="meta">Pursuits and skills developed over time.</p>
    {hobbies.length === 0 && <p class="meta">Entries are currently in preparation.</p>}
    <div class="grid">{hobbyCategories.flatMap((c) => hobbies.filter((e) => e.data.category === c)).map((entry) => <SidequestCard entry={entry} />)}</div>
  </section>
</Base>
<style>
  .lede { color: var(--muted); font-size: 1.1rem; }
  .meta { color: var(--muted); }
  .toc { display: flex; gap: 16px; margin: 8px 0 8px; }
  .group { border-top: 1px solid var(--border); margin-top: 32px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-bottom: 24px; }
</style>
