---
import Base from '../layouts/Base.astro';
import SidequestCard from '../components/SidequestCard.astro';
import Tile from '../components/Tile.astro';
import { showDrafts } from '../lib/drafts';
import { getCollection } from 'astro:content';
const travel = (await getCollection('adventures', ({ data }) => data.category === 'Travel' && (!data.draft || showDrafts)))
  .sort((a, b) => (b.data.start?.valueOf() ?? 0) - (a.data.start?.valueOf() ?? 0));
// Japan and Korea have their own sections; other travel entries are listed as cards.
const regions = [
  { name: 'Japan', href: '/japan/', blurb: 'Four trips, including the 2025 study abroad, with route maps and day-by-day timelines.' },
  { name: 'Korea', href: '/korea/', blurb: 'A week in Seoul during the 2025 study abroad, including the DMZ and Waterbomb.' },
];
const otherTravel = travel.filter((e) => e.data.region !== 'Japan' && e.data.region !== 'South Korea');
---
<Base title="Travel · Sidequest Resume" description="Trips and journeys, organized by country.">
  <h1>Travel</h1>
  <p class="lede">Trips and journeys, organized by country.</p>
  <div class="grid">
    {regions.map((r) => (
      <Tile href={r.href} title={r.name} meta="Travel · Country" blurb={r.blurb} />
    ))}
    {otherTravel.map((entry) => <SidequestCard entry={entry} />)}
  </div>
</Base>
<style>
  .lede { color: var(--muted); font-size: 1.1rem; }
  .meta { color: var(--muted); }
  .toc { display: flex; gap: 16px; margin: 8px 0 8px; }
  .group { border-top: 1px solid var(--border); margin-top: 32px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-bottom: 24px; }
</style>
