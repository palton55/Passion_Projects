---
import Base from '../../layouts/Base.astro';
import SidequestCard from '../../components/SidequestCard.astro';
import { showDrafts } from '../../lib/drafts';
import { getCollection } from 'astro:content';
import { regions, type Region } from '../../data/regions';
export function getStaticPaths() {
  return regions.filter((r) => !r.href).map((region) => ({ params: { region: region.slug }, props: { region } }));
}
const { region } = Astro.props as { region: Region };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = (await getCollection('adventures', ({ data }) => data.region === region.region && (!data.draft || showDrafts)))
  .sort((a, b) => (b.data.start?.valueOf() ?? 0) - (a.data.start?.valueOf() ?? 0));
---
<Base title={`${region.name} · Sidequest Resume`} description={region.blurb}>
  <p class="crumb"><a href={`${base}/travel/`}>Experience</a></p>
  <h1>{region.name}</h1>
  <p class="lede">{region.blurb}</p>
  {entries.length === 0 && <p class="meta pending">Entries are currently in preparation.</p>}
  <div class="grid">{entries.map((entry) => <SidequestCard entry={entry} />)}</div>
</Base>
<style>
  .crumb { color: var(--muted); font-size: .9rem; margin: 0 0 8px; }
  .lede { font-size: 1.1rem; max-width: 680px; }
  .meta { color: var(--muted); }
  .pending { font-style: italic; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin: 24px 0; }
</style>
